    hidpp_device_t *dev, uint8_t first, uint8_t last, struct hidpp_color color
);\fR
.fi
.PP
Sets all zones from \fBfirst\fR to \fBlast\fR to the same color.
.SS hidpp_perkey_set_color
.PP
.nf
\fBHIDPP_API int hidpp_perkey_set_color(
    hidpp_device_t *dev,
    const uint8_t *ids,
    size_t count,
    struct hidpp_color color
);\fR
.fi
.PP
Sets the zones \fBids\fR to the same color.
.SS hidpp_perkey_update
.PP
.nf
\fBHIDPP_API int hidpp_perkey_update(
    hidpp_device_t *dev,
    uint8_t first,
    const struct hidpp_color *previous,
    const struct hidpp_color *current,
    size_t count
);\fR
.fi
.PP
Changes the colors of \fBcount\fR consecutive zones starting at \fBfirst\fR from
\fBprevious\fR (what the device shows) to \fBcurrent\fR. Only changed zones are
sent, and delta compression is used where possible, which keeps the
traffic low when the colors change smoothly. Returns the number of
requests that were needed.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
