\fBstruct hidpp_keymap_info {
    uint16_t id;
    uint8_t index;
    uint16_t taskId;
    uint8_t flags;
    uint8_t position;
    uint8_t group;
    uint8_t groupMask;
    uint8_t rawXY;

    hidpp_bool_t isVirtual;
    hidpp_bool_t isPersistable;
    hidpp_bool_t isDivertable;
    hidpp_bool_t isReprogrammable;
    hidpp_bool_t isFnTogglable;
    hidpp_bool_t isHotkey;
    hidpp_bool_t isFunctionKey;
    hidpp_bool_t isMouseButton;

    hidpp_bool_t initialized;
    const char *name;
    const char *taskName;
    const char *remapName;
};\fR
.fi
.PP
Information about an individual control (button or key).
.SS hidpp_keymap_info
.PP
.nf
\fBHIDPP_API struct hidpp_keymap_info *hidpp_keymap_info(
    hidpp_keymap_t *map, uint16_t id
);\fR
.fi
.PP
Reads device's keymap information about the given control \fBid\fR.
.SS hidpp_keymap_state
.PP
.nf
\fBstruct hidpp_keymap_state {
    uint16_t remapId;
    uint8_t flags;
    hidpp_bool_t rawXY;
    hidpp_bool_t isPersistent;
    hidpp_bool_t isDiverted;
};\fR
.fi
.PP
Information about control's current state.
.SS hidpp_keymap_state
.PP
.nf
\fBHIDPP_API int hidpp_keymap_state(
    hidpp_keymap_t *map, uint16_t id, struct hidpp_keymap_state *out
);\fR
.fi
.PP
Reads current state of the control with \fBid\fR.
.SS hidpp_battery_info
.PP
.nf
\fBstruct hidpp_battery_info {
    uint8_t levelCount;
    uint8_t flags;
    uint16_t nominalLife;
    uint8_t criticalLevel;

    hidpp_bool_t disabledOSD;
    hidpp_bool_t enabledMileage;
    hidpp_bool_t isRechargable;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
HID++ Battery capabilities.
.SS hidpp_battery_status
.PP
.nf
\fBstruct hidpp_battery_status {
    uint8_t dischargeLevel;
    uint8_t dischargeNextLevel;
    uint8_t status;

    const char *statusName;
    const char *levelName;
};\fR
.fi
.PP
Battery discharge status.
.SS hidpp_battery_info
.PP
.nf
\fBHIDPP_API struct hidpp_battery_info *hidpp_battery_info(hidpp_device_t *dev);\fR
.fi
.PP
Returns device's battery capabilities.
.SS hidpp_battery_status
.PP
.nf
\fBHIDPP_API struct hidpp_battery_status *hidpp_battery_status(
    hidpp_device_t *dev
);\fR
.fi
.PP
Queries the device for it's current discharge level.
.SS HIDPP_HOST_CURRENT
.PP
.nf
\fB#define HIDPP_HOST_CURRENT 0xFF\fR
.fi
.PP
Selects the host the device is currently connected to. Usable wherever a
host index is expected by the host, backlight and action functions.
.SS hidpp_host_bus
.PP
.nf
\fBenum hidpp_host_bus {
    HIDPP_HOST_BUS_NONE = 0,
    HIDPP_HOST_BUS_EQUAD = 1,
    HIDPP_HOST_BUS_USB = 2,
    HIDPP_HOST_BUS_BT = 3,
    HIDPP_HOST_BUS_BLE = 4,
    HIDPP_HOST_BUS_BLE_PRO = 5,
};\fR
.fi
.PP
Bus (transport) a host is paired through.
.SS hidpp_host_info
.PP
.nf
\fBstruct hidpp_host_info {
    uint8_t count;
    uint16_t capabilities;

    hidpp_bool_t canSwitch;
    hidpp_bool_t hasHostInfo;
    hidpp_bool_t canGetName;
    hidpp_bool_t canSetName;
    hidpp_bool_t canMove;
    hidpp_bool_t canDelete;
    hidpp_bool_t hasOsVersion;
    hidpp_bool_t hasEQuadDescriptor;
    hidpp_bool_t hasUSBDescriptor;
    hidpp_bool_t hasBTDescriptor;
    hidpp_bool_t hasBLEDescriptor;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
Multi\-host capabilities (features 0x1814 and 0x1815).
.SS hidpp_host_status
.PP
.nf
\fBstruct hidpp_host_status {
    uint8_t index;
    uint8_t status;
    uint8_t busType;
    uint8_t numPages;
    uint8_t nameLength;
    uint8_t nameMaxLength;

    hidpp_bool_t isPaired;
    const char *busName;
};\fR
.fi
.PP
State of a single host slot.
.SS hidpp_host_os
.PP
.nf
\fBstruct hidpp_host_os {
    uint8_t type;
    uint8_t version;
    uint16_t revision;
    uint16_t build;
};\fR
.fi
.PP
Host operating system, as stored by software (the firmware never reads
it). All fields are zero if nothing has been stored.
.SS hidpp_host_descriptor
.PP
.nf
\fBstruct hidpp_host_descriptor {
    uint8_t index;
    uint8_t busType;
    uint8_t data[14];
};\fR
.fi
.PP
One page of the host descriptor. \fBdata\fR is the raw payload that follows
the (host, bus) header and its layout depends on \fBbusType\fR.
.SS hidpp_host_info
.PP
.nf
\fBHIDPP_API struct hidpp_host_info *hidpp_host_info(hidpp_device_t *dev);\fR
.fi
.PP
Returns the multi\-host capabilities of the device.
Errors (as NULL): device has neither of the host features.
.SS hidpp_host_current
.PP
.nf
\fBHIDPP_API int hidpp_host_current(hidpp_device_t *dev);\fR
.fi
.PP
Returns the index of the host the device is connected to, or an error.
This is never cached, the device can be switched by its user.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_switch
.PP
.nf
\fBHIDPP_API int hidpp_host_switch(hidpp_device_t *dev, uint8_t host);\fR
.fi
.PP
Switches the device to another host. The device is most probably going to
disconnect from this host and no answer is awaited: success only means
that the request was sent.
.PP
\fBErrors\fR
.PP
EINVAL (no such host), ENOSYS, EIO.
.SS hidpp_host_status
.PP
.nf
\fBHIDPP_API int hidpp_host_status(
    hidpp_device_t *dev, uint8_t host, struct hidpp_host_status *out
);\fR
.fi
.PP
Reads the status of \fBhost\fR (or HIDPP_HOST_CURRENT).
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_name
.PP
.nf
\fBHIDPP_API int hidpp_host_name(
    hidpp_device_t *dev, uint8_t host, char *out, size_t size
);\fR
.fi
.PP
Copies the friendly name of \fBhost\fR into \fBout\fR (always null terminated,
truncated to \fBsize \- 1\fR bytes). Returns the number of bytes written,
excluding the terminator. Unpaired hosts have an empty name.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_set_name
.PP
.nf
\fBHIDPP_API int hidpp_host_set_name(
    hidpp_device_t *dev, uint8_t host, const char *name
);\fR
.fi
.PP
Sets the friendly name of \fBhost\fR. The name must be printable ASCII and
not longer than the \fBnameMaxLength\fR of the host.
.PP
\fBErrors\fR
.PP
EINVAL, ENOMEM (too long), ENOSYS, EIO.
.SS hidpp_host_move
.PP
.nf
\fBHIDPP_API int hidpp_host_move(
    hidpp_device_t *dev, uint8_t host, uint8_t newIndex
);\fR
.fi
.PP
Moves a host to a different slot. Other hosts may shift up or down.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_delete
.PP
.nf
\fBHIDPP_API int hidpp_host_delete(hidpp_device_t *dev, uint8_t host);\fR
.fi
.PP
Unpairs \fBhost\fR, which makes its slot available for new pairing.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_os
.PP
.nf
\fBHIDPP_API int hidpp_host_os(
    hidpp_device_t *dev, uint8_t host, struct hidpp_host_os *out
);\fR
.fi
.PP
Reads the operating system stored for \fBhost\fR.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_set_os
.PP
.nf
\fBHIDPP_API int hidpp_host_set_os(
    hidpp_device_t *dev, uint8_t host, const struct hidpp_host_os *os
);\fR
.fi
.PP
Stores the operating system of \fBhost\fR.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_descriptor
.PP
.nf
\fBHIDPP_API int hidpp_host_descriptor(
    hidpp_device_t *dev,
    uint8_t host,
    uint8_t page,
    struct hidpp_host_descriptor *out
);\fR
.fi
.PP
Reads a page (0 .. numPages \- 1) of the descriptor of \fBhost\fR.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_cookie
.PP
.nf
\fBHIDPP_API int hidpp_host_cookie(hidpp_device_t *dev, uint8_t host);\fR
.fi
.PP
Returns the cookie (a persistent byte of software defined meaning) of
\fBhost\fR, or an error. Cookies are cleared by the firmware when a new
host is paired.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_host_set_cookie
.PP
.nf
\fBHIDPP_API int hidpp_host_set_cookie(
    hidpp_device_t *dev, uint8_t host, uint8_t cookie
);\fR
.fi
.PP
Writes the cookie of \fBhost\fR.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_backlight_mode
.PP
.nf
\fBenum hidpp_backlight_mode {
    HIDPP_BACKLIGHT_MODE_NONE = 0,
    HIDPP_BACKLIGHT_MODE_AUTO = 1,
    HIDPP_BACKLIGHT_MODE_TEMP_MANUAL = 2,
    HIDPP_BACKLIGHT_MODE_PERM_MANUAL = 3,
};\fR
.fi
.PP
Backlight modes selectable by software (feature 0x1982 v3).
.SS hidpp_backlight_effect
.PP
.nf
\fBenum hidpp_backlight_effect {
    HIDPP_BACKLIGHT_EFFECT_STATIC = 0,
    HIDPP_BACKLIGHT_EFFECT_NONE = 1,
    HIDPP_BACKLIGHT_EFFECT_BREATHING = 2,
    HIDPP_BACKLIGHT_EFFECT_CONTRAST = 3,
    HIDPP_BACKLIGHT_EFFECT_REACTION = 4,
    HIDPP_BACKLIGHT_EFFECT_RANDOM = 5,
    HIDPP_BACKLIGHT_EFFECT_WAVES = 6,
};\fR
.fi
.PP
Backlight effects. The value is the bit index in the effect list.
.SS hidpp_backlight_status
.PP
.nf
\fBenum hidpp_backlight_status {
    HIDPP_BACKLIGHT_DISABLED_BY_SW = 0,
    HIDPP_BACKLIGHT_DISABLED_BY_BATTERY = 1,
    HIDPP_BACKLIGHT_ALS = 2,
    HIDPP_BACKLIGHT_ALS_SATURATED = 3,
    HIDPP_BACKLIGHT_MANUAL_TEMPORARY = 4,
    HIDPP_BACKLIGHT_MANUAL_PERMANENT = 5,
};\fR
.fi
.PP
Backlight status reported by the device.
.SS hidpp_backlight_info
.PP
.nf
\fBstruct hidpp_backlight_info {
    uint8_t version;
    uint8_t levelCount;
    uint16_t effectList;

    hidpp_bool_t hasEffects;
    hidpp_bool_t hasDurations;
    hidpp_bool_t supportsWow;
    hidpp_bool_t supportsCrown;
    hidpp_bool_t supportsPowerSave;
    hidpp_bool_t supportsAutoMode;
    hidpp_bool_t supportsTempManualMode;
    hidpp_bool_t supportsPermManualMode;


    uint16_t defaultDurationHandsOut;
    uint16_t defaultDurationHandsIn;
    uint16_t defaultDurationPowered;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
Backlight capabilities. They do not change at runtime.
.SS hidpp_backlight_config
.PP
.nf
\fBstruct hidpp_backlight_config {
    hidpp_bool_t enabled;
    hidpp_bool_t wow;
    hidpp_bool_t crown;
    hidpp_bool_t powerSave;
    uint8_t mode;
    uint8_t effect;
    uint8_t level;
    uint16_t durationHandsOut;
    uint16_t durationHandsIn;
    uint16_t durationPowered;
};\fR
.fi
.PP
Backlight configuration, stored persistently on the device. Durations are
in seconds, from 5 seconds to 2 hours, in steps of 5 seconds.
.SS hidpp_backlight_state
.PP
.nf
\fBstruct hidpp_backlight_state {
    uint8_t levelCount;
    uint8_t level;
    uint8_t status;
    uint8_t effect;

    const char *statusName;
    const char *effectName;
};\fR
.fi
.PP
What the backlight is doing right now.
.SS hidpp_backlight_info
.PP
.nf
\fBHIDPP_API struct hidpp_backlight_info *hidpp_backlight_info(
    hidpp_device_t *dev
);\fR
.fi
.PP
Returns the backlight capabilities.
Errors (as NULL): the device has no supported backlight feature.
.SS hidpp_backlight_get
.PP
.nf
\fBHIDPP_API int hidpp_backlight_get(
    hidpp_device_t *dev, struct hidpp_backlight_config *out
);\fR
.fi
.PP
Reads the stored backlight configuration.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_backlight_set
.PP
.nf
\fBHIDPP_API int hidpp_backlight_set(
    hidpp_device_t *dev, const struct hidpp_backlight_config *config
);\fR
.fi
.PP
Writes the whole backlight configuration, which is meant to be modified
after hidpp_backlight_get(). Options the device does not support are
rejected.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_backlight_state
.PP
.nf
\fBHIDPP_API int hidpp_backlight_state(
    hidpp_device_t *dev, struct hidpp_backlight_state *out
);\fR
.fi
.PP
Queries what the backlight is currently doing.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_backlight_set_effect
.PP
.nf
\fBHIDPP_API int hidpp_backlight_set_effect(hidpp_device_t *dev, uint8_t effect);\fR
.fi
.PP
Applies a backlight effect until the next power cycle (it is not stored).
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_backlight_effect_name
.PP
.nf
\fBHIDPP_API const char *hidpp_backlight_effect_name(uint8_t effect);\fR
.fi
.PP
Returns the name of a backlight effect.
.SS hidpp_illumination_control
.PP
.nf
\fBenum hidpp_illumination_control {
    HIDPP_ILLUMINATION_BRIGHTNESS = 0,
    HIDPP_ILLUMINATION_COLOR_TEMPERATURE = 1,
};\fR
.fi
.PP
Individually controllable properties of an illumination device.
.SS hidpp_illumination_info
.PP
.nf
\fBstruct hidpp_illumination_info {
    uint16_t min;
    uint16_t max;
    uint16_t res;
    uint8_t maxLevels;
    uint8_t flags;

    hidpp_bool_t hasEvents;
    hidpp_bool_t hasLinearLevels;
    hidpp_bool_t hasNonLinearLevels;
    hidpp_bool_t hasDynamicMaximum;
    hidpp_bool_t isSettable;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
Capabilities of a single control. They do not change at runtime.
.SS hidpp_illumination_levels
.PP
.nf
\fBstruct hidpp_illumination_levels {
    hidpp_bool_t linear;
    uint16_t min;
    uint16_t max;
    uint16_t step;
    uint8_t count;
    uint16_t values[HIDPP_ILLUMINATION_MAX_LEVELS];
};\fR
.fi
.PP
User\-selectable values of a control.
.SS hidpp_illumination_info
.PP
.nf
\fBHIDPP_API struct hidpp_illumination_info *hidpp_illumination_info(
    hidpp_device_t *dev, int control
);\fR
.fi
.PP
Returns the capabilities of \fBcontrol\fR.
Errors (as NULL): no illumination feature or invalid control.
.SS hidpp_illumination_get
.PP
.nf
\fBHIDPP_API int hidpp_illumination_get(hidpp_device_t *dev);\fR
.fi
.PP
Returns 0 (off), 1 (on) or an error.
.SS hidpp_illumination_set
.PP
.nf
\fBHIDPP_API int hidpp_illumination_set(hidpp_device_t *dev, int state);\fR
.fi
.PP
Turns the light on (\fBstate\fR != 0) or off.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_illumination_value
.PP
.nf
\fBHIDPP_API int hidpp_illumination_value(hidpp_device_t *dev, int control);\fR
.fi
.PP
Returns the current value of \fBcontrol\fR or an error.
.SS hidpp_illumination_set_value
.PP
.nf
\fBHIDPP_API int hidpp_illumination_set_value(
    hidpp_device_t *dev, int control, uint16_t value
);\fR
.fi
.PP
Sets the value of \fBcontrol\fR. The value must be within the range of the
control and a multiple of its resolution.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_illumination_levels
.PP
.nf
\fBHIDPP_API int hidpp_illumination_levels(
    hidpp_device_t *dev, int control, struct hidpp_illumination_levels *out
);\fR
.fi
.PP
Reads the levels of \fBcontrol\fR.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_illumination_set_levels
.PP
.nf
\fBHIDPP_API int hidpp_illumination_set_levels(
    hidpp_device_t *dev,
    int control,
    const struct hidpp_illumination_levels *levels
);\fR
.fi
.PP
Replaces the levels of \fBcontrol\fR.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_illumination_reset_levels
.PP
.nf
\fBHIDPP_API int hidpp_illumination_reset_levels(hidpp_device_t *dev, int control);\fR
.fi
.PP
Resets the levels of \fBcontrol\fR to factory defaults.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_illumination_effective_max
.PP
.nf
\fBHIDPP_API int hidpp_illumination_effective_max(hidpp_device_t *dev);\fR
.fi
.PP
Returns the effective maximum brightness, which is 0 if none is in effect.
The device can answer with a "busy" error while it is still testing
itself, which is reported as EAGAIN; try again later.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EAGAIN, EIO.
.SS hidpp_action_type
.PP
