.SS hidpp_touchpad_report
.PP
.nf
\fBenum hidpp_touchpad_report {
    HIDPP_TOUCHPAD_RAW = 0x01,
    HIDPP_TOUCHPAD_FORCE = 0x02,
    HIDPP_TOUCHPAD_ENHANCED = 0x04,
    HIDPP_TOUCHPAD_WIDTH_HEIGHT = 0x08,
    HIDPP_TOUCHPAD_NATIVE_GESTURES = 0x10,
    HIDPP_TOUCHPAD_MAJOR_MINOR = 0x20,
    HIDPP_TOUCHPAD_WIDTH_HEIGHT8 = 0x40,
};\fR
.fi
.PP
Raw report bits of a touchpad (feature 0x6100).
.SS hidpp_touch_origin
.PP
.nf
\fBenum hidpp_touch_origin {
    HIDPP_ORIGIN_LOWER_LEFT = 1,
    HIDPP_ORIGIN_LOWER_RIGHT = 2,
    HIDPP_ORIGIN_UPPER_LEFT = 3,
    HIDPP_ORIGIN_UPPER_RIGHT = 4,
};\fR
.fi
.PP
Corner of a touch surface its coordinates start from.
.SS hidpp_touchpad_info
.PP
.nf
\fBstruct hidpp_touchpad_info {
    uint16_t width;
    uint16_t height;
    uint8_t zRange;
    uint8_t areaRange;
    uint8_t timestampUnit;
    uint8_t maxFingers;
    uint8_t origin;
    uint8_t mappingVersion;
    uint16_t dpi;

    hidpp_bool_t hasPen;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
Touchpad characteristics (feature 0x6100).
.SS hidpp_touchpad_info
.PP
.nf
\fBHIDPP_API struct hidpp_touchpad_info *hidpp_touchpad_info(hidpp_device_t *dev);\fR
.fi
.PP
Returns the touchpad characteristics.
Errors (as NULL): device has no raw touchpad feature.
.SS hidpp_touchpad_get_mode
.PP
.nf
\fBHIDPP_API int hidpp_touchpad_get_mode(hidpp_device_t *dev);\fR
.fi
.PP
Returns the raw report bits (enum hidpp_touchpad_report) or an error.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_touchpad_set_mode
.PP
.nf
\fBHIDPP_API int hidpp_touchpad_set_mode(hidpp_device_t *dev, uint8_t mode);\fR
.fi
.PP
Sets the raw report bits. Raw reporting turns HID reports off.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_touch_mouse_mode
.PP
.nf
\fBenum hidpp_touch_mouse_mode {
    HIDPP_TOUCH_MOUSE_NATIVE = 0,
    HIDPP_TOUCH_MOUSE_RAW = 1,
    HIDPP_TOUCH_MOUSE_RAW_GESTURES = 2,
    HIDPP_TOUCH_MOUSE_RAW_ALWAYS = 3,
    HIDPP_TOUCH_MOUSE_RAW_GESTURES_Z = 4,
};\fR
.fi
.PP
Raw modes of a touch mouse (feature 0x6110).
.SS hidpp_touch_mouse_info
.PP
.nf
\fBstruct hidpp_touch_mouse_info {
    uint16_t xMax;
    uint16_t yMax;
    uint16_t dpi;
    uint8_t origin;
    uint8_t maxFingers;
    uint8_t contactMax;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
Touch mouse characteristics (feature 0x6110).
.SS hidpp_touch_mouse_info
.PP
.nf
\fBHIDPP_API struct hidpp_touch_mouse_info *hidpp_touch_mouse_info(
    hidpp_device_t *dev
);\fR
.fi
.PP
Returns the touch mouse characteristics.
Errors (as NULL): device has no touch mouse feature.
.SS hidpp_touch_mouse_get_mode
.PP
.nf
\fBHIDPP_API int hidpp_touch_mouse_get_mode(hidpp_device_t *dev);\fR
.fi
.PP
Returns the raw mode (enum hidpp_touch_mouse_mode) or an error.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_touch_mouse_set_mode
.PP
.nf
\fBHIDPP_API int hidpp_touch_mouse_set_mode(hidpp_device_t *dev, uint8_t mode);\fR
.fi
.PP
Sets the raw mode.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_brightness_info
.PP
.nf
\fBstruct hidpp_brightness_info {
    uint8_t version;
    uint16_t min;
    uint16_t max;
    uint16_t steps;
    uint8_t capabilities;

    hidpp_bool_t hasHwBrightness;
    hidpp_bool_t hasEvents;
    hidpp_bool_t hasState;
    hidpp_bool_t hasHwOnOff;
    hidpp_bool_t isTransient;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
Brightness control capabilities (feature 0x8040). They are meant for
cosmetic and RGB lighting, white illumination uses feature 0x1990.
.SS hidpp_brightness_info
.PP
.nf
\fBHIDPP_API struct hidpp_brightness_info *hidpp_brightness_info(
    hidpp_device_t *dev
);\fR
.fi
.PP
Returns the brightness capabilities.
Errors (as NULL): device has no brightness control.
.SS hidpp_brightness_get
.PP
.nf
\fBHIDPP_API int hidpp_brightness_get(hidpp_device_t *dev);\fR
.fi
.PP
Returns the brightness or an error.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_brightness_set
.PP
.nf
\fBHIDPP_API int hidpp_brightness_set(hidpp_device_t *dev, uint16_t value);\fR
.fi
.PP
Sets the brightness (\fBmin\fR to \fBmax\fR).
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_brightness_state
.PP
.nf
\fBHIDPP_API int hidpp_brightness_state(hidpp_device_t *dev);\fR
.fi
.PP
Returns 1 if the lighting is on, 0 if it is off, or an error.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_brightness_set_state
.PP
.nf
\fBHIDPP_API int hidpp_brightness_set_state(hidpp_device_t *dev, int on);\fR
.fi
.PP
Turns the lighting on (\fBon\fR != 0) or off.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_connection
.PP
.nf
\fBenum hidpp_connection {
    HIDPP_CONNECTION_WIRED = 0,
    HIDPP_CONNECTION_WIRELESS = 1,
    HIDPP_CONNECTION_CURRENT = 0xFF,
};\fR
.fi
.PP
Connection types a report rate applies to.
.SS hidpp_report_rate_info
.PP
.nf
\fBstruct hidpp_report_rate_info {
    hidpp_bool_t isExtended;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
Report rate capabilities (features 0x8060 and 0x8061).
.SS hidpp_report_rate_info
.PP
.nf
\fBHIDPP_API struct hidpp_report_rate_info *hidpp_report_rate_info(
    hidpp_device_t *dev
);\fR
.fi
.PP
Returns the report rate capabilities.
Errors (as NULL): device has neither of the report rate features.
.SS hidpp_report_rate_list
.PP
.nf
\fBHIDPP_API int hidpp_report_rate_list(
    hidpp_device_t *dev, uint8_t connection, uint16_t *out, size_t max
);\fR
.fi
.PP
Copies up to \fBmax\fR report intervals (in microseconds, shortest first)
supported on \fBconnection\fR into \fBout\fR and returns their count. For
HIDPP_CONNECTION_CURRENT these are the ones usable right now. Only
0x8061 devices accept other connection types.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_report_rate_get
.PP
.nf
\fBHIDPP_API int hidpp_report_rate_get(hidpp_device_t *dev, uint8_t connection);\fR
.fi
.PP
Returns the report interval (in microseconds) of \fBconnection\fR or an
error.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_report_rate_set
.PP
.nf
\fBHIDPP_API int hidpp_report_rate_set(hidpp_device_t *dev, uint16_t interval);\fR
.fi
.PP
Sets the report interval of the current connection in microseconds.
The device must be in host mode.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_led_effect_id
.PP
.nf
\fBenum hidpp_led_effect_id {
    HIDPP_LED_DISABLED = 0,
    HIDPP_LED_FIXED = 1,
    HIDPP_LED_PULSING = 2,
    HIDPP_LED_CYCLING = 3,
    HIDPP_LED_WAVE = 4,
    HIDPP_LED_STARLIGHT = 5,
    HIDPP_LED_LIGHT_ON_PRESS = 6,
    HIDPP_LED_AUDIO = 7,
    HIDPP_LED_BOOT_UP = 8,
    HIDPP_LED_DEMO = 9,
    HIDPP_LED_BREATHING = 10,
    HIDPP_LED_RIPPLE = 11,
    HIDPP_LED_ONBOARD = 12,
};\fR
.fi
.PP
Effect identifiers of features 0x8070 and 0x8071.
.SS hidpp_led_persistence
.PP
.nf
\fBenum hidpp_led_persistence {
    HIDPP_LED_VOLATILE = 0x01,
    HIDPP_LED_NON_VOLATILE = 0x02,
};\fR
.fi
.PP
Where an effect is stored. Values can be combined.
.SS hidpp_led_nv_capability
.PP
.nf
\fBenum hidpp_led_nv_capability {
    HIDPP_LED_NV_BOOT_UP = 0x0001,
    HIDPP_LED_NV_DEMO = 0x0002,
    HIDPP_LED_NV_USER_DEMO = 0x0004,
    HIDPP_LED_NV_EVENTS_DISPLAY = 0x0008,
    HIDPP_LED_NV_ACTIVE_DIMMING = 0x0010,
    HIDPP_LED_NV_RAMP_DOWN = 0x0020,
    HIDPP_LED_NV_SHUTDOWN = 0x0040,
};\fR
.fi
.PP
Non\-volatile capabilities (see struct hidpp_led_nv).
.SS hidpp_led_sw_control
.PP
.nf
\fBenum hidpp_led_sw_control {
    HIDPP_LED_SW_EFFECTS = 0x01,
    HIDPP_LED_SW_POWER_MODES = 0x02,
};\fR
.fi
.PP
Software control flags (see hidpp_led_sw_control_set()).
.SS hidpp_led_notification
.PP
.nf
\fBenum hidpp_led_notification {
    HIDPP_LED_NOTIFY_SYNC = 0x01,
    HIDPP_LED_NOTIFY_ACTIVITY = 0x02,
    HIDPP_LED_NOTIFY_TIMEOUT = 0x04,
};\fR
.fi
.PP
Notification flags (see hidpp_led_sw_control_set()).
.SS hidpp_led_power_mode
.PP
.nf
\fBenum hidpp_led_power_mode {
    HIDPP_LED_POWER_FULL = 1,
    HIDPP_LED_POWER_SAVE = 2,
    HIDPP_LED_POWER_OFF = 3,
};\fR
.fi
.PP
RGB power modes (feature 0x8071).
.SS HIDPP_LED_ALL_ZONES
.PP
.nf
\fB#define HIDPP_LED_ALL_ZONES 0xFF\fR
.fi
.PP
Use as a zone index to address every zone at once (0x8071).
.SS hidpp_led_info
.PP
.nf
\fBstruct hidpp_led_info {
    uint8_t version;
    uint8_t zoneCount;
    uint16_t nvCapabilities;
    uint16_t extCapabilities;
    uint8_t multiZoneEffects;

    hidpp_bool_t isRgbEffects;
    hidpp_bool_t hasZoneEffect;
    hidpp_bool_t hasSettings;
    hidpp_bool_t canSetBin;
    hidpp_bool_t isMonochrome;
    hidpp_bool_t hasSync;
    hidpp_bool_t hasShutdown;
    hidpp_bool_t hasChangedEvents;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
Color LED capabilities (features 0x8070 and 0x8071, called zones and
RGB clusters respectively).
.SS hidpp_led_zone
.PP
.nf
\fBstruct hidpp_led_zone {
    uint8_t index;
    uint16_t location;
    uint8_t effectCount;
    uint8_t displayPersistency;
    uint8_t effectPersistency;
    hidpp_bool_t hasPatterns;
    const char *locationName;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
A zone (an RGB cluster) of LEDs.
.SS hidpp_led_effect_info
.PP
.nf
\fBstruct hidpp_led_effect_info {
    uint8_t zone;
    uint8_t index;
    uint16_t id;
    uint16_t capabilities;
    uint16_t period;
    const char *name;
    hidpp_bool_t initialized;
};\fR
.fi
.PP
An effect that can be played on a zone.
.SS hidpp_led_effect
.PP
.nf
\fBstruct hidpp_led_effect {
    uint8_t zone;
    uint8_t index;
    uint8_t persistence;
    uint8_t powerMode;
    uint8_t params[10];
};\fR
.fi
.PP
Raw effect configuration. The meaning of \fBparams\fR depends on the effect
id; hidpp_led_pack() and hidpp_led_unpack() convert them.
.SS hidpp_led_params
.PP
.nf
\fBstruct hidpp_led_params {
    uint8_t red, green, blue;
    uint8_t red2, green2, blue2;
    uint16_t period;
    uint8_t speed;
    uint8_t intensity;
    uint8_t waveform;
    uint8_t direction;
    uint8_t ramp;
    uint16_t delay;
};\fR
.fi
.PP
Typed effect parameters. Fields an effect does not use are ignored. A
16\-bit period is only available if it is at least 256 ms, otherwise the
8\-bit, device dependent \fBspeed\fR is used.
.SS hidpp_led_nv
.PP
.nf
\fBstruct hidpp_led_nv {
    uint16_t capability;
    uint8_t state;
    uint8_t params[6];
};\fR
.fi
.PP
Non\-volatile configuration.
.SS hidpp_led_bin
.PP
.nf
\fBstruct hidpp_led_bin {
    uint8_t zone;
    uint8_t binIndex;
    uint8_t data[8];
};\fR
.fi
.PP
LED bin information (calibration data stored during manufacturing).
For 0x8070 \fBdata\fR holds the red, green, blue and white values as big
endian words; for 0x8071 the layout depends on \fBbinIndex\fR.
.SS hidpp_led_settings
.PP
.nf
\fBstruct hidpp_led_settings {
    uint8_t red, green, blue;
    uint16_t period;
    uint8_t brightness;
    uint8_t param;
};\fR
.fi
.PP
Effect settings of a zone (0x8070).
.SS hidpp_led_power_config
.PP
.nf
\fBstruct hidpp_led_power_config {
    uint16_t flags;
    uint16_t toPowerSave;
    uint16_t toOff;
};\fR
.fi
.PP
RGB power mode configuration (0x8071). Timeouts are in seconds,
0xFFFF means never.
.SS hidpp_led_info
.PP
.nf
\fBHIDPP_API struct hidpp_led_info *hidpp_led_info(hidpp_device_t *dev);\fR
.fi
.PP
Returns the color LED capabilities.
Errors (as NULL): device has neither of the color LED features.
.SS hidpp_led_zone
.PP
.nf
\fBHIDPP_API struct hidpp_led_zone *hidpp_led_zone(
    hidpp_device_t *dev, uint8_t zone
);\fR
.fi
.PP
Returns the information about a zone (not HIDPP_LED_ALL_ZONES).
Errors (as NULL): no color LED feature or no such zone.
.SS hidpp_led_effect_info
.PP
.nf
\fBHIDPP_API struct hidpp_led_effect_info *hidpp_led_effect_info(
    hidpp_device_t *dev, uint8_t zone, uint8_t index
);\fR
.fi
.PP
Returns the information about the effect \fBindex\fR of \fBzone\fR, which can be
HIDPP_LED_ALL_ZONES for the multi\-zone effects of 0x8071.
Errors (as NULL): no color LED feature, no such zone or effect.
.SS hidpp_led_find_effect
.PP
.nf
\fBHIDPP_API int hidpp_led_find_effect(
    hidpp_device_t *dev, uint8_t zone, uint16_t id
);\fR
.fi
.PP
Returns the index of the effect with \fBid\fR in \fBzone\fR, or an error.
.PP
\fBErrors\fR
.PP
EINVAL, ENOENT, ENOSYS, EIO.
.SS hidpp_led_effect_name
.PP
.nf
\fBHIDPP_API const char *hidpp_led_effect_name(uint16_t id);\fR
.fi
.PP
Returns the name of an effect id.
.SS hidpp_led_pack
.PP
.nf
\fBHIDPP_API int hidpp_led_pack(
    uint16_t id, const struct hidpp_led_params *params, uint8_t out[10]
);\fR
.fi
.PP
Converts typed parameters of the effect \fBid\fR to raw ones.
.PP
\fBErrors\fR
.PP
EINVAL (unknown effect or unrepresentable period).
.SS hidpp_led_unpack
.PP
.nf
\fBHIDPP_API int hidpp_led_unpack(
    uint16_t id, const uint8_t params[10], struct hidpp_led_params *out
);\fR
.fi
.PP
Converts raw parameters of the effect \fBid\fR to typed ones.
.PP
\fBErrors\fR
.PP
EINVAL (unknown effect).
.SS hidpp_led_set_effect
.PP
.nf
\fBHIDPP_API int hidpp_led_set_effect(
    hidpp_device_t *dev, const struct hidpp_led_effect *effect
);\fR
.fi
.PP
Plays an effect. The zone, effect and persistence are checked against
the capabilities of the device.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_led_get_effect
.PP
.nf
\fBHIDPP_API int hidpp_led_get_effect(
    hidpp_device_t *dev,
    uint8_t zone,
    uint8_t persistence,
    struct hidpp_led_effect *out
);\fR
.fi
.PP
Reads the effect of a zone, either the playing one or the stored one
(\fBpersistence\fR is HIDPP_LED_NON_VOLATILE).
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_led_nv_get
.PP
.nf
\fBHIDPP_API int hidpp_led_nv_get(
    hidpp_device_t *dev, uint16_t capability, struct hidpp_led_nv *out
);\fR
.fi
.PP
Reads the non\-volatile configuration of \fBcapability\fR.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_led_nv_set
.PP
.nf
\fBHIDPP_API int hidpp_led_nv_set(
    hidpp_device_t *dev, const struct hidpp_led_nv *config
);\fR
.fi
.PP
Changes the non\-volatile configuration.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_led_sw_control_get
.PP
.nf
\fBHIDPP_API int hidpp_led_sw_control_get(
    hidpp_device_t *dev, uint8_t *control, uint8_t *notifications
);\fR
.fi
.PP
Reads who controls the LEDs (enum hidpp_led_sw_control) and which
notifications are sent (enum hidpp_led_notification).
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_led_sw_control_set
.PP
.nf
\fBHIDPP_API int hidpp_led_sw_control_set(
    hidpp_device_t *dev, uint8_t control, uint8_t notifications
);\fR
.fi
.PP
Changes who controls the LEDs and which notifications are sent.
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_led_bin_get
.PP
.nf
\fBHIDPP_API int hidpp_led_bin_get(
    hidpp_device_t *dev,
    uint8_t zone,
    uint8_t binIndex,
    int backup,
    struct hidpp_led_bin *out
);\fR
.fi
.PP
Reads LED bin information. \fBbackup\fR reads the copy stored by feature
0x1806 (0x8071 only).
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_led_bin_set
.PP
