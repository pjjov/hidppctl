    hidpp_device_t *dev,
    const uint8_t *ids,
    const struct hidpp_color *colors,
    size_t count
);\fR
.fi
.PP
Sets the colors of the zones \fBids\fR. Zone ids 0 and 255 are invalid.
Changes are only shown after hidpp_perkey_frame_end().
.PP
\fBErrors\fR
.PP
EINVAL, ENOSYS, EIO.
.SS hidpp_perkey_set_consecutive
.PP
.nf
\fBHIDPP_API int hidpp_perkey_set_consecutive(
    hidpp_device_t *dev,
    uint8_t first,
    const struct hidpp_color *colors,
