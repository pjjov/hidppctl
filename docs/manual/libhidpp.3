.PP
.nf
\fBHIDPP_API struct hidpp_action_info *hidpp_action_info(hidpp_device_t *dev);\fR
.fi
.PP
Returns what actions the device can perform.
Errors (as NULL): the device has no persistent action feature.
.SS hidpp_action_id
.PP
.nf
\fBHIDPP_API int hidpp_action_id(hidpp_device_t *dev, uint8_t index);\fR
.fi
.PP
Returns the control ID at the given table index or an error.
.SS hidpp_action_list
.PP
.nf
\fBHIDPP_API size_t
hidpp_action_list(hidpp_device_t *dev, uint16_t *out, size_t max);\fR
.fi
.PP
Copies up to \fBmax\fR control IDs into \fBout\fR and returns their count.
.SS hidpp_action_get
.PP
.nf
\fBHIDPP_API int hidpp_action_get(
    hidpp_device_t *dev, uint16_t id, uint8_t host, struct hidpp_action *out
);\fR
.fi
.PP
Reads the action stored for control \fBid\fR on \fBhost\fR.
.PP
\fBErrors\fR
.PP
EINVAL, ENOENT (no such control), ENOSYS, EIO.
.SS hidpp_action_set
.PP
.nf
\fBHIDPP_API int hidpp_action_set(
    hidpp_device_t *dev,
    uint16_t id,
    uint8_t host,
    uint8_t type,
    uint16_t value,
    uint8_t modifiers
);\fR
.fi
.PP
Stores the action of control \fBid\fR on \fBhost\fR in the device's memory.
.PP
\fBErrors\fR
